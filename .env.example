# Copy this file to .env to configure the server when running it outside Docker.
# The server reads .env at startup; real environment variables take precedence.

# The database from `docker compose up -d db` (host port 5433).
DATABASE_URL=postgres://ottv2:ottv2@localhost:5433/ottv2

PORT=6767
# MOVE_DELAY_MS=600
# MOVE_TIME_LIMIT_MS=1000
